# === Server ===
ORIGYN_HOST=0.0.0.0
ORIGYN_PORT=8000
ORIGYN_CORS_ORIGINS=*

# === Hardware Profile ===
# Auto-detected if not set. Options: lite, standard, performance
# ORIGYN_PROFILE=standard
# ORIGYN_DEVICE=cpu          # cpu or cuda
# ORIGYN_TORCH_THREADS=1

# === Workers ===
# ORIGYN_FULL_WORKERS=6      # Threads for full 23-engine analysis
# ORIGYN_SNIPPET_WORKERS=4   # Threads for snippet/quick scans
# ORIGYN_MAX_CONCURRENT_FULL=2
# ORIGYN_MAX_CONCURRENT_SNIPPET=4
# ORIGYN_RESERVED_CORES=2

# === Database ===
ORIGYN_DATA_DIR=./data
ORIGYN_DB_NAME=origyn.db
# ORIGYN_CACHE_ENABLED=true
# ORIGYN_DB_TIMEOUT=30.0
# ORIGYN_DB_BUSY_TIMEOUT=5000

# === HuggingFace Models ===
HF_HOME=./models
